import { createClient } from "@/lib/supabase/server";
import { redirect } from "next/navigation";
import { Suspense } from "react";
import { TabContainer } from "./tab-container";
import { AkunTab } from "./akun-tab";
import { KategoriTab } from "./kategori-tab";

export const metadata = {
  title: "Pengaturan",
};

export default async function PengaturanPage() {
  const supabase = await createClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) redirect("/login");

  const { data: kategoriList } = await supabase
    .from("categories")
    .select("*")
    .eq("user_id", user.id)
    .order("komoditas", { ascending: true });

  // Ambil komoditas unik dari harvests user (yang ada data panen)
  const { data: harvestsKomoditas } = await supabase
    .from("harvests")
    .select("komoditas")
    .eq("user_id", user.id);

  const komoditasSet = new Set<string>();
  (harvestsKomoditas || []).forEach((h) => {
    if (h.komoditas) komoditasSet.add(h.komoditas);
  });
  const komoditasList = Array.from(komoditasSet).sort();

  // Ambil profil
  const { data: profil } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", user.id)
    .single();

  return (
    <div className="p-4 md:p-6 max-w-4xl mx-auto">
      {/* Header */}
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-gray-900">⚙️ Pengaturan</h1>
        <p className="text-gray-600 text-sm mt-1">
          Kelola akun dan standar produktivitas Anda
        </p>
      </div>

      <Suspense
        fallback={
          <div className="bg-white border border-gray-200 rounded-xl p-8 text-center">
            <div className="text-3xl mb-3">⏳</div>
            <div className="text-sm text-gray-500">Memuat...</div>
          </div>
        }
      >
        <TabContainer
          akunContent={
            <AkunTab
              user={user}
              profil={profil || null}
            />
          }
          kategoriContent={
            <KategoriTab
              userId={user.id}
              kategoriList={kategoriList || []}
              komoditasList={komoditasList}
            />
          }
        />
      </Suspense>
    </div>
  );
}
