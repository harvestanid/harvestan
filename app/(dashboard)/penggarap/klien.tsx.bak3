"use client";

import { useState } from "react";
import Link from "next/link";

type Penggarap = {
  id: string;
  nama: string;
  kontak: string | null;
  alamat: string | null;
  is_self: boolean;
  totalLahan: number;
  totalLuas: number;
  jmlPanen: number;
  komoditasDitanam: string[];
  produktivitas: {
    komoditas: string;
    produktivitasRata: number;
    jmlPanen: number;
    totalHasilKg: number;
    kategori: { label: string; icon: string; color: string } | null;
  }[];
  lahanList: {
    id: string;
    nama: string;
    luas: number;
    lokasi_koordinat: string | null;
    tipe_garap: string;
    nama_owner_external: string | null;
    jmlPanen: number;
    totalHasilKg: number;
    rataProduktivitas: number;
    komoditasList: string[];
    komoditasRingkas: {
      komoditas: string;
      jml: number;
      isPerMusim: boolean;
      totalHasilKg: number;
    }[];
    tahunRingkas: {
      tahun: number;
      komoditasList: string[];
      totalHasilKg: number;
      jmlPanenRaw: number;
      jmlMusim: number;
      profitOwner: number;
      profitPenggarap: number;
    }[];
    riwayatPanen: {
      id: string;
      tanggal: string;
      komoditas: string;
      musim: string | null;
      hasilKg: number;
      hargaGabah: number;
      profitBersih: number;
      profitOwner: number;
      profitPenggarap: number;
      potonganHutang: number;
      sisaHutangSesudah: number;
      totalHutangSebelum: number;
      persenOwner: number;
      persenPenggarap: number;
    }[];
  }[];
};

const KOMODITAS_LABEL: Record<string, string> = {
  padi: "🌾 Padi",
  jagung: "🌽 Jagung",
  kacang_tanah: "🥜 Kacang Tanah",
  bawang_merah: "🧅 Bawang Merah",
  cabai_rawit: "🌶️ Cabai Rawit",
  cabai: "🌶️ Cabai",
};

function formatRp(n: number) {
  return "Rp " + Math.round(n).toLocaleString("id-ID");
}

function PenggarapCard({
  p,
  defaultOpen,
}: {
  p: Penggarap;
  defaultOpen: boolean;
}) {
  const [open, setOpen] = useState(defaultOpen);
  const [openLahan, setOpenLahan] = useState<string | null>(null);
  const [openTahun, setOpenTahun] = useState<string | null>(null);

  function toggleLahan(id: string) {
    setOpenLahan((prev) => (prev === id ? null : id));
    setOpenTahun(null);
  }

  function toggleTahun(id: string) {
    setOpenTahun((prev) => (prev === id ? null : id));
  }

  return (
    <div className="bg-white border-2 border-gray-100 rounded-2xl shadow-sm overflow-hidden">
      <button
        onClick={() => setOpen(!open)}
        className="w-full text-left p-5 hover:bg-gray-50 transition"
      >
        <div className="flex items-start justify-between gap-3">
          <div className="flex-1 min-w-0">
            <div className="flex items-center gap-2 flex-wrap">
              <h3 className="font-bold text-base text-[#2c5e2e] truncate">
                {p.is_self ? `🌱 ${p.nama}` : `👨‍🌾 ${p.nama}`}
              </h3>
              {p.is_self && (
                <span className="text-[9px] bg-[#2c5e2e]/10 text-[#2c5e2e] font-bold px-2 py-0.5 rounded-full border border-[#2c5e2e]/20">
                  DIRI SENDIRI
                </span>
              )}
            </div>

            {p.kontak && (
              <div className="text-xs text-gray-500 mt-1">📞 {p.kontak}</div>
            )}
            {p.alamat && (
              <div className="text-xs text-gray-500 mt-0.5 truncate">
                📍 {p.alamat}
              </div>
            )}

            <div className="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-[11px] text-gray-600">
              <span className="flex items-center gap-1">
                🗺️ {p.totalLahan} lahan
              </span>
              <span className="flex items-center gap-1">
                📏 {p.totalLuas.toFixed(2)} Ha
              </span>
              <span className="flex items-center gap-1">
                🌾 {p.jmlPanen}x panen
              </span>
            </div>

            {p.komoditasDitanam.length > 0 && (
              <div className="flex flex-wrap gap-1 mt-2">
                {p.komoditasDitanam.map((k) => (
                  <span
                    key={k}
                    className="text-[9px] bg-orange-50 text-orange-700 border border-orange-200 px-1.5 py-0.5 rounded-full font-medium"
                  >
                    {KOMODITAS_LABEL[k] || k}
                  </span>
                ))}
              </div>
            )}
          </div>

          <span className="text-gray-400 text-lg flex-shrink-0">
            {open ? "▲" : "▼"}
          </span>
        </div>
      </button>

      {open && (
        <div className="px-5 pb-5 space-y-3 border-t border-gray-100 pt-4">
          {p.produktivitas.length > 0 && (
            <div>
              <div className="text-[10px] font-bold text-gray-500 uppercase tracking-wide mb-2">
                📊 Produktivitas per Komoditas
              </div>
              <div className="space-y-1.5">
                {p.produktivitas.map((pk) => (
                  <div
                    key={pk.komoditas}
                    className="flex items-center justify-between text-xs bg-gray-50 rounded-lg px-3 py-2 gap-2 flex-wrap"
                  >
                    <span className="font-medium text-gray-700">
                      {KOMODITAS_LABEL[pk.komoditas] || pk.komoditas}
                    </span>
                    <div className="flex items-center gap-2 flex-wrap">
                      <span className="text-gray-600">
                        {pk.produktivitasRata.toFixed(0)} Kg/Ha
                      </span>
                      {pk.kategori && (
                        <span
                          className={`text-[9px] px-1.5 py-0.5 rounded-full font-bold border ${pk.kategori.color}`}
                        >
                          {pk.kategori.icon} {pk.kategori.label}
                        </span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {p.lahanList.length > 0 && (
            <div>
              <div className="text-[10px] font-bold text-gray-500 uppercase tracking-wide mb-2">
                🗺️ Daftar Lahan ({p.lahanList.length})
              </div>
              <div className="space-y-2">
                {p.lahanList.map((l) => {
                  const isLahanOpen = openLahan === l.id;

                  return (
                    <div
                      key={l.id}
                      className="border-2 border-gray-100 rounded-xl overflow-hidden"
                    >
                      <button
                        onClick={() => toggleLahan(l.id)}
                        className="w-full text-left p-3 hover:bg-gray-50 transition"
                      >
                        <div className="flex items-center justify-between gap-2">
                          <div className="flex-1 min-w-0">
                            <div className="flex items-center gap-1.5 flex-wrap">
                              <span className="font-bold text-[#2c5e2e] text-sm truncate">
                                🗺️ {l.nama}
                              </span>
                              {l.tipe_garap === "mandiri" && (
                                <span className="text-[9px] bg-green-100 text-green-800 border border-green-300 px-1.5 py-0.5 rounded-full font-bold">
                                  🌱 Mandiri
                                </span>
                              )}
                              {l.tipe_garap === "bagi_hasil_owner" && (
                                <span className="text-[9px] bg-blue-100 text-blue-800 border border-blue-300 px-1.5 py-0.5 rounded-full font-bold">
                                  👤 Owner
                                </span>
                              )}
                              {l.tipe_garap === "bagi_hasil_penggarap" && (
                                <span className="text-[9px] bg-orange-100 text-orange-800 border border-orange-300 px-1.5 py-0.5 rounded-full font-bold">
                                  👨‍🌾 Penggarap
                                </span>
                              )}
                            </div>
                            <div className="text-[11px] text-gray-600 mt-1 flex flex-wrap gap-x-2 gap-y-0.5">
                              <span>📏 {l.luas.toFixed(2)} Ha</span>
                              <span>
                                🌾 {l.jmlPanen}x panen
                              </span>
                              <span>
                                📊{" "}
                                {l.totalHasilKg.toLocaleString("id-ID")} Kg
                              </span>
                              {l.rataProduktivitas > 0 && (
                                <span>
                                  ⚡ {l.rataProduktivitas.toFixed(0)} Kg/Ha
                                </span>
                              )}
                            </div>
                          </div>
                          <span className="text-gray-400 text-sm flex-shrink-0">
                            {isLahanOpen ? "▲" : "▼"}
                          </span>
                        </div>
                      </button>

                      {isLahanOpen && (
                        <div className="bg-gray-50 border-t border-gray-200 p-3 space-y-2">
                          <div className="text-[10px] font-bold text-gray-500 uppercase mb-1">
                            📅 Riwayat Panen ({l.jmlPanen})
                          </div>

                          {l.jmlPanen === 0 ? (
                            <div className="text-xs text-gray-400 italic text-center py-2">
                              Belum ada panen di lahan ini
                            </div>
                          ) : (
                            <div className="space-y-1.5">
                              {l.tahunRingkas.map((t) => {
                                const key = `${l.id}-${t.tahun}`;
                                const isTahunOpen = openTahun === key;

                                return (
                                  <div
                                    key={t.tahun}
                                    className="bg-white rounded-lg border border-gray-200 overflow-hidden"
                                  >
                                    <button
                                      onClick={() => toggleTahun(key)}
                                      className="w-full text-left p-2 hover:bg-gray-50 transition"
                                    >
                                      <div className="flex items-center justify-between gap-2 flex-wrap">
                                        <div className="flex items-center gap-2 flex-wrap">
                                          <span className="font-bold text-gray-900 text-sm">
                                            📅 {t.tahun}
                                          </span>
                                          <span className="text-[10px] bg-gray-100 text-gray-700 px-1.5 py-0.5 rounded-full">
                                            {t.jmlMusim} musim
                                          </span>
                                          <span className="text-[10px] bg-gray-100 text-gray-700 px-1.5 py-0.5 rounded-full">
                                            {t.jmlPanenRaw} panen
                                          </span>
                                        </div>
                                        <div className="flex items-center gap-1">
                                          <div className="text-[10px] text-gray-500">
                                            Total:{" "}
                                            {t.totalHasilKg.toLocaleString(
                                              "id-ID"
                                            )}{" "}
                                            Kg
                                          </div>
                                          <span className="text-gray-400 text-sm">
                                            {isTahunOpen ? "▲" : "▼"}
                                          </span>
                                        </div>
                                      </div>
                                      <div className="flex flex-wrap gap-1 mt-1.5">
                                        {t.komoditasList.map((k) => (
                                          <span
                                            key={k}
                                            className="text-[9px] bg-orange-50 text-orange-700 border border-orange-200 px-1.5 py-0.5 rounded-full"
                                          >
                                            {KOMODITAS_LABEL[k] || k}
                                          </span>
                                        ))}
                                      </div>
                                      <div className="grid grid-cols-2 gap-2 mt-2">
                                        <div className="bg-green-50 border border-green-200 rounded p-1.5 text-center">
                                          <div className="text-[9px] text-green-700">
                                            👤 Owner
                                          </div>
                                          <div className="font-bold text-green-800 text-[11px] break-all">
                                            {formatRp(t.profitOwner)}
                                          </div>
                                        </div>
                                        <div className="bg-orange-50 border border-orange-200 rounded p-1.5 text-center">
                                          <div className="text-[9px] text-orange-700">
                                            👨‍🌾 Penggarap
                                          </div>
                                          <div className="font-bold text-orange-800 text-[11px] break-all">
                                            {formatRp(t.profitPenggarap)}
                                          </div>
                                        </div>
                                      </div>
                                    </button>
                                  </div>
                                );
                              })}
                            </div>
                          )}

                          <div className="flex flex-wrap gap-2 pt-2">
                            <Link
                              href={`/penggarap/${p.id}/lahan/${l.id}`}
                              className="flex-1 min-w-[100px] bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold text-center py-2 rounded-lg transition"
                            >
                              Detail Lahan
                            </Link>
                            <Link
                              href={`/panen-multi?penggarapId=${p.id}&landId=${l.id}`}
                              className="flex-1 min-w-[100px] bg-green-700 hover:bg-green-800 text-white text-xs font-bold text-center py-2 rounded-lg transition"
                            >
                              + Input Panen
                            </Link>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          <div className="flex flex-wrap gap-2 pt-2">
            <Link
              href={`/penggarap/${p.id}`}
              className="flex-1 min-w-[140px] bg-[#2c5e2e] hover:bg-[#1f4521] text-white text-sm font-bold text-center py-2.5 rounded-lg transition"
            >
              📋 Detail Lengkap
            </Link>
            <Link
              href={`/penggarap/${p.id}/lahan/baru`}
              className="flex-1 min-w-[140px] bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-bold text-center py-2.5 rounded-lg transition"
            >
              + Tambah Lahan
            </Link>
          </div>
        </div>
      )}
    </div>
  );
}

export function PenggarapKlien({
  penggarapLengkap,
}: {
  penggarapLengkap: Penggarap[];
}) {
  return (
    <div className="space-y-3">
      {penggarapLengkap.map((p, idx) => (
        <PenggarapCard key={p.id} p={p} defaultOpen={idx === 0} />
      ))}
    </div>
  );
}
